# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO

# --- PostgreSQL ---
DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:5432/ledgerlens

# --- Job queue ---
REDIS_URL=redis://localhost:6379/0

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX=ledgerlens-chunks
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=dev
# Set to the Pinecone Local emulator URL to develop offline
PINECONE_HOST=

# --- LLM providers ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AWS_REGION=us-east-1

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# --- Observability ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ledgerlens
PHOENIX_COLLECTOR_ENDPOINT=
