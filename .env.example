# Copy to .env and fill in. Never commit .env.

# --- App ---
# dev | eval | prod: also picks the Pinecone namespace unless PINECONE_NAMESPACE is set
APP_ENV=dev
LOG_LEVEL=INFO
# Browser origins allowed to call the API (the Next.js dashboard), comma-separated
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# API keys callers must send as X-API-Key (or Authorization: Bearer), comma-separated.
# Empty = no auth (local development only). The dashboard sends LEDGERLENS_API_KEY.
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=
# Chat runs one client may start (each can call paid LLMs): N/second|minute|hour,
# or N/10s. Empty = no limit. Counted per API process.
CHAT_RATE_LIMIT=20/minute
# Seconds before an ordinary request is answered 504, and before a chat run is stopped
REQUEST_TIMEOUT_S=60
CHAT_TIMEOUT_S=180
# Optional: path to the YAML config directory (defaults to <repo>/configs)
# CONFIGS_DIR=configs

# --- PostgreSQL ---
DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:5432/ledgerlens
# Host port for the compose Postgres; change it (and the port above) if 5432 is taken
# POSTGRES_PORT=5432

# --- Job queue ---
REDIS_URL=redis://localhost:6379/0

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX=ledgerlens-chunks
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
# Overrides the namespace APP_ENV selects; must be listed in configs/pinecone.yaml
# PINECONE_NAMESPACE=dev
# Leave empty for Pinecone cloud. For the Pinecone Local emulator in docker-compose use
# PINECONE_HOST=http://localhost:5080 (PINECONE_API_KEY can then be any value, e.g. pclocal)
PINECONE_HOST=

# --- LLM providers ---
OPENAI_API_KEY=
# Optional: an OpenAI-compatible gateway instead of api.openai.com
# OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_API_KEY=                  # Gemini API key (Google AI Studio)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
OLLAMA_BASE_URL=http://localhost:11434
AWS_REGION=us-east-1
# A configs/models.yaml profile applied over the model aliases: aws | gcp | empty (as written).
# The AWS deployment sets aws (Bedrock first for `smart`).
LLM_PROFILE=

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# --- Observability ---
# true: also record every LLM call (tokens, cost, latency) in Postgres llm_calls (run make init first)
LLM_COST_DB=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ledgerlens
PHOENIX_COLLECTOR_ENDPOINT=
# Traces of every /chat run (router -> agents -> tools -> LLM calls); off by default.
# jsonl writes spans to TRACING_PATH (python -m ledgerlens.observability.tracing show).
TRACING_ENABLED=false
TRACING_BACKEND=langsmith
TRACING_PATH=data/interim/traces.jsonl
TRACING_SAMPLE_RATE=1.0
