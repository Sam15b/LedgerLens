# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
# Optional: path to the YAML config directory (defaults to <repo>/configs)
# CONFIGS_DIR=configs

# --- PostgreSQL ---
DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:5432/ledgerlens
# Host port for the compose Postgres; change it (and the port above) if 5432 is taken
# POSTGRES_PORT=5432

# --- Job queue ---
REDIS_URL=redis://localhost:6379/0

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# --- Pinecone ---
PINECONE_API_KEY=
PINECONE_INDEX=ledgerlens-chunks
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=dev
# Leave empty for Pinecone cloud. For the Pinecone Local emulator in docker-compose use
# PINECONE_HOST=http://localhost:5080 (PINECONE_API_KEY can then be any value, e.g. pclocal)
PINECONE_HOST=

# --- LLM providers ---
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
AWS_REGION=us-east-1

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
EMBEDDING_DIM=768

# --- Observability ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ledgerlens
PHOENIX_COLLECTOR_ENDPOINT=
