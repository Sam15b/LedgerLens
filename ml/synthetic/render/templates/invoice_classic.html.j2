{#- Layout 1: title on top, every field written as "Label: value" on one line. -#}
<div class="classic">
<h1>INVOICE</h1>
<table>
  <tr>
    <td class="half">
      <b>{{ doc.vendor_name }}</b><br/>
      {% for line in vendor_address %}{{ line }}<br/>{% endfor %}
      {% if doc.vendor_tax_id %}VAT No: {{ doc.vendor_tax_id }}{% endif %}
    </td>
    <td class="half right">
      Invoice No: {{ doc.invoice_number }}<br/>
      Invoice Date: {{ doc.invoice_date | date("long") }}<br/>
      {% if doc.due_date %}Due Date: {{ doc.due_date | date("long") }}<br/>{% endif %}
      {% if doc.po_number %}PO Number: {{ doc.po_number }}{% endif %}
    </td>
  </tr>
</table>
<p><b>Bill To:</b> {{ doc.customer_name }}<br/>
{% for line in customer_address %}{{ line }}<br/>{% endfor %}</p>

{% if doc.line_items %}
<table class="lines">
  <tr><th>Description</th><th class="num">Qty</th><th class="num">Unit price</th><th class="num">Amount</th></tr>
  {% for line in doc.line_items %}
  <tr>
    <td>{{ line.description }}</td>
    <td class="num">{{ line.quantity | qty }}</td>
    <td class="num">{{ line.unit_price | amount(doc.currency) }}</td>
    <td class="num">{{ line.amount | amount(doc.currency) }}</td>
  </tr>
  {% endfor %}
</table>
{% else %}
<p>For goods and services supplied as agreed.</p>
{% endif %}

<table class="totals">
  {% if doc.subtotal is not none %}<tr><td>Subtotal: {{ doc.currency }} {{ doc.subtotal | amount(doc.currency) }}</td></tr>{% endif %}
  {% if doc.tax is not none %}<tr><td>VAT ({{ tax_rate }}): {{ doc.tax | amount(doc.currency) }}</td></tr>{% endif %}
  <tr><td><b>Total Due: {{ doc.currency }} {{ doc.total | amount(doc.currency) }}</b></td></tr>
</table>
{% if terms_days is not none %}<p class="muted">Payment terms: net {{ terms_days }} days. Please quote the invoice number with your payment.</p>{% endif %}
</div>
