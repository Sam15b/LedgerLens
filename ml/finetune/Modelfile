# Ollama model for the fine-tuned extractor (docs/layers/06-fine-tuning.md, "Serving").
#
#   python -m ml.finetune.merge_and_export --adapter <run>/adapter --out <export>
#   ollama create ledgerlens-llama3-lora -f <export>/Modelfile
#
# merge_and_export.py copies this file next to the GGUF it writes; FROM is relative to
# the Modelfile, so run `ollama create` on that copy.

FROM ./ledgerlens-llama3-lora.Q4_K_M.gguf

# Llama 3 Instruct chat format, the one the adapter was trained on
# (ml/finetune/prepare_dataset.py: chat_messages + the tokenizer's chat template).
TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""

# The training system prompt, word for word (prepare_dataset.SYSTEM_PROMPT); the user turn
# is "<task naming the keys>\n\nDocument text:\n<OCR text>", sent by the caller.
SYSTEM """You extract structured fields from business documents. Reply with one JSON object and nothing else."""

# Greedy decoding, as in the evaluation (ml/finetune/infer.py).
PARAMETER temperature 0
PARAMETER top_k 1
PARAMETER seed 13
# Training cut sequences at 2,048 tokens (longest example 1,111); 4,096 leaves room for
# long documents plus the reply.
PARAMETER num_ctx 4096
PARAMETER num_predict 768
PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
PARAMETER stop "<|eot_id|>"
