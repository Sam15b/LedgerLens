  "info": {
    "description": "Agentic GraphRAG over invoices, purchase orders and contracts.",
    "title": "LedgerLens API",
    "version": "0.7.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/anomalies": {
      "get": {
        "description": "Flagged invoices to review, highest score first.",
        "operationId": "list_anomalies_anomalies_get",
        "parameters": [
          {
            "in": "query",
            "name": "review",
            "required": false,
            "schema": {
              "default": "unreviewed",
              "enum": [
                "unreviewed",
                "reviewed",
                "confirmed",
                "false_positive",
                "all"
              ],
              "title": "Review",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "min_score",
            "required": false,
            "schema": {
              "default": 0.25,
              "maximum": 1,
              "minimum": 0,
              "title": "Min Score",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "vendor_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Vendor Id"
            }
          },
          {
            "in": "query",
            "name": "model_version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Model Version"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AnomalyOut"
                  },
                  "title": "Response List Anomalies Anomalies Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Anomalies",
        "tags": [
          "anomalies"
        ]
      }
    },
    "/anomalies/{score_id}/review": {
      "post": {
        "description": "Mark a flag ``confirmed`` or ``false_positive`` (kept for retraining).",
        "operationId": "review_anomaly_anomalies__score_id__review_post",
        "parameters": [
          {
            "in": "path",
            "name": "score_id",
            "required": true,
            "schema": {
              "title": "Score Id",
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnomalyOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Review Anomaly",
        "tags": [
          "anomalies"
        ]
      }
    },
    "/chat": {
      "post": {
        "description": "Run the agents on a message; stream ``tool_call`` / ``tool_result`` / ``token`` /\n``citation`` / ``interrupt`` events and a final ``done`` (SSE).",
        "operationId": "chat_chat_post",
