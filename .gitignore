# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Env / secrets
.env
.env.*
!.env.example

# Data (keep folder structure + golden set)
data/**
!data/**/
!data/**/.gitkeep
!data/golden/*.jsonl

# Models / weights / artifacts
models/
*.safetensors
*.bin
*.gguf
*.keras
*.h5
*.pt
ml/**/runs/
# fine-tuning run logs are small JSON files (config, data hashes, metrics); the
# checkpoints and adapter weights go to the run's checkpoint_dir instead
!ml/finetune/runs/
outputs/
ml/**/checkpoints/
wandb/
mlruns/

# Notebooks
.ipynb_checkpoints/

# Node / web
node_modules/
web/.next/
web/out/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Private daily implementation plan (local only, never pushed)
docs/daily-plan/

# Terraform (infra/*): providers, state and per-person settings stay local;
# .terraform.lock.hcl is committed
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.tfvars
!*.tfvars.example
backend.hcl
